<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- 中文注释：本清单描述无行为树规控编排包的身份、构建依赖与运行期插件依赖。 -->
  <name>nav2_regulated_modules</name>
  <version>0.1.0</version>
  <description>Standalone planning and control bringup package without simulation assets.</description>
  <maintainer email="zpy@example.com">zpy</maintainer>
  <license>Apache-2.0</license>

  <!-- 中文注释：使用 ament_cmake 构建 C++ 生命周期节点。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- 中文注释：编译期依赖覆盖消息、Action、Lifecycle、Nav2 工具和 TF 变换。 -->
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_util</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>spdlog_wrapper</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- 中文注释：运行期依赖覆盖 Launch、Nav2 服务器、规划控制插件和底盘输出节点。 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <!-- 中文注释：恢复由规控节点直接清理代价地图，不依赖 nav2_behaviors 或路点服务器。 -->
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_theta_star_planner</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_graceful_controller</exec_depend>
  <exec_depend>nav2_rotation_shim_controller</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>dwb_critics</exec_depend>
  <exec_depend>dwb_plugins</exec_depend>
  <exec_depend>controlpub</exec_depend>
  <exec_depend>myagv_keyboard_control</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- 中文注释：向 ROS 2 索引声明本包采用 ament_cmake 构建类型。 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
